# ---------------------------------------------------------------------------
# Build products of install/build-all.sh (also run by install.sh).
# The rule is simple: nothing that a make produces is tracked, including the
# precompiled binary drop the install script can unpack into bin/.
# ---------------------------------------------------------------------------
*.o
*.d
*.so

# ...but the OS-integration fragment directories really are named *.d
# (sysusers.d, tmpfiles.d, udev.d); *.d is here for gcc's dependency files,
# not to hide them. The first line re-includes the directory so the second
# can reach its files.
!packaging/systemd/*.d/
!packaging/systemd/*.d/*

# bison/flex and the permission symbol table generator
lex.yy.c
y.tab.c
y.tab.h
permsyms.def.c

# the programs, left in their source directories by their makefiles
/src/macro/macro1_1
/src/scanpf/scanpf
/src/pidp1_test/pidp1_test
/src/pdp1central/pdp1central
/src/pdp1_periph/pdp1_periph
/src/pdp1_periph/pdp1_periphES
/src/usb_paper_tape/pdp1_usb_monitor

# the same, in bin/ (the links build-all.sh makes plus the copies the tools' install rules leave)
/bin/ad1
/bin/asr33tape
/bin/disassemble
/bin/docviewer
/bin/drumlist
/bin/drumupdater
/bin/fastload
/bin/fstool
