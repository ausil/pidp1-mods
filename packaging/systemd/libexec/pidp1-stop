#!/bin/sh
# ExecStop for pdp1.service: end the engine the way pdp1control stop does --
# SIGHUP first (the emulator's graceful path), plain TERM if it is still
# there, and only tear the screen session down if the process outlived both.
# Runs as the service user, so it sees exactly the session it is stopping.
# The session's socket directory is the one pidp1-screen pins.
SCREENDIR=/run/pidp1/screen
export SCREENDIR

alive() { screen -ls pidp1 2>/dev/null | grep -qE '[0-9]+\.pidp1[[:space:]]'; }

alive || exit 0
pkill -x -HUP pdp1
i=0
while alive && [ "$i" -lt 50 ]; do
	sleep 0.1
	i=$((i + 1))
done
pkill -x pdp1 2>/dev/null
i=0
while alive && [ "$i" -lt 50 ]; do
	sleep 0.1
	i=$((i + 1))
done
alive && screen -S pidp1 -X quit
exit 0
