#!/bin/bash
# sucks that we need bash here
#
# Send tapevis (the tape reader and punch window) a command, expanding the PDP1_DIR token
# the boot configurations use for the tape library.
. "${PIDP1_ENV:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/pidp1-env.sh}"

PDP1_DIR="$PIDP1_TAPES"
# a bit crappy. pdp1 should be able to handle multiple lines
#while IFS= read -r line; do
echo "$1" | sed "s:PDP1_DIR:${PDP1_DIR}:g" 
echo "$1" | sed "s:PDP1_DIR:${PDP1_DIR}:g" | ncat -w 1 localhost 1050 
#done
